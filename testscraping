from __future__ import annotations
"""
test_scraping.py — Teste le scraping en isolation pour diagnostiquer les problèmes
"""
import requests
from bs4 import BeautifulSoup
import json

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/123.0.0.0 Safari/537.36"
    ),
    "Accept-Language": "fr-FR,fr;q=0.9",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
}

def test_lbc():
    print("\n── Test LeBonCoin ──")
    url = "https://www.leboncoin.fr/recherche?text=Renault+Clio&category=2"
    print(f"URL : {url}")
    try:
        resp = requests.get(url, headers=HEADERS, timeout=10)
        print(f"Status HTTP : {resp.status_code}")
        print(f"Taille réponse : {len(resp.text)} caractères")

        # Cherche le JSON interne
        soup = BeautifulSoup(resp.text, "html.parser")
        script = soup.find("script", id="__NEXT_DATA__")
        if script:
            data = json.loads(script.string)
            ads = (data.get("props", {})
                       .get("pageProps", {})
                       .get("searchData", {})
                       .get("ads", []))
            print(f"✅ JSON trouvé — {len(ads)} annonces")
            if ads:
                a = ads[0]
                print(f"   Exemple : {a.get('subject')} — {a.get('price')} €")
        else:
            print("❌ Pas de __NEXT_DATA__ — anti-bot actif")
            # Affiche un extrait du HTML pour diagnostic
            print(f"   Début HTML : {resp.text[:300]}")

    except Exception as e:
        print(f"❌ Erreur : {e}")

def test_lacentrale():
    print("\n── Test La Centrale ──")
    url = "https://www.lacentrale.fr/listing?makesModelsCommercialNames=Renault%3AClio"
    print(f"URL : {url}")
    try:
        resp = requests.get(url, headers=HEADERS, timeout=10)
        print(f"Status HTTP : {resp.status_code}")
        print(f"Taille réponse : {len(resp.text)} caractères")

        soup = BeautifulSoup(resp.text, "html.parser")
        # Cherche des prix
        prices = soup.select("[class*='price']")
        print(f"Éléments prix trouvés : {len(prices)}")
        if prices:
            print(f"   Exemple : {prices[0].get_text(strip=True)[:80]}")
        else:
            print("❌ Aucun prix trouvé — anti-bot probable")
            print(f"   Début HTML : {resp.text[:300]}")

    except Exception as e:
        print(f"❌ Erreur : {e}")

def test_autoscout24():
    print("\n── Test AutoScout24 (alternative) ──")
    url = "https://www.autoscout24.fr/lst/renault/clio?sort=standard&desc=0&cy=F&ustate=N,U"
    print(f"URL : {url}")
    try:
        resp = requests.get(url, headers=HEADERS, timeout=10)
        print(f"Status HTTP : {resp.status_code}")
        print(f"Taille réponse : {len(resp.text)} caractères")

        soup = BeautifulSoup(resp.text, "html.parser")
        # AutoScout24 met les données en JSON dans un script
        scripts = soup.find_all("script", type="application/json")
        print(f"Scripts JSON trouvés : {len(scripts)}")
        for s in scripts[:3]:
            txt = (s.string or "")[:100]
            if "price" in txt.lower() or "offer" in txt.lower():
                print(f"   Candidat : {txt}...")

        # Cherche aussi les prix directement
        prices = soup.select("[data-testid*='price'], [class*='Price'], [class*='price']")
        print(f"Éléments prix : {len(prices)}")
        if prices:
            print(f"   Exemple : {prices[0].get_text(strip=True)[:60]}")

    except Exception as e:
        print(f"❌ Erreur : {e}")

if __name__ == "__main__":
    test_lbc()
    test_lacentrale()
    test_autoscout24()
    print("\n✅ Tests terminés.")